<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FenCalc2.ViewModels"
        x:Class="FenCalc2.Views.RenameFloorView"
        x:DataType="vm:RenameFloorViewModel"
        Title="Rename Floor"
        Width="232" Height="230"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,12,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Rename" Command="{Binding OkCommand}" Width="80" Padding="6,4" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" Click="OnCancelClick" Width="80" Padding="6,4" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="8">
            <StackPanel Spacing="4">
                <TextBlock Text="Floor to rename:" FontSize="12" />
                <ComboBox ItemsSource="{Binding FloorNames}" SelectedItem="{Binding SelectedFloor}" Width="200" FontSize="12" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="New floor name:" FontSize="12" />
                <TextBox Text="{Binding NewFloorName}" Width="200" FontSize="12" />
            </StackPanel>
            <TextBlock Text="Windows, floor area and plan image stay on the floor."
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </DockPanel>
</Window>
