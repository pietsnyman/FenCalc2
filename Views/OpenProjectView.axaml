<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FenCalc2.ViewModels"
        x:Class="FenCalc2.Views.OpenProjectView"
        x:DataType="vm:OpenProjectViewModel"
        Title="Open Project"
        Width="232" Height="270"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,12,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="OK" Command="{Binding OkCommand}" Width="80" Padding="6,4" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" Click="OnCancelClick" Width="80" Padding="6,4" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="10">
            <StackPanel Spacing="4">
                <TextBlock Text="Client:" FontSize="12" />
                <ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}" Width="200" FontSize="12" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Project:" FontSize="12" />
                <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" Width="200" FontSize="12" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Building:" FontSize="12" />
                <ComboBox ItemsSource="{Binding Buildings}" SelectedItem="{Binding SelectedBuilding}" Width="200" FontSize="12" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
