<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FenCalc2.ViewModels"
        x:Class="FenCalc2.Views.NewProjectView"
        x:DataType="vm:NewProjectViewModel"
        Title="New Project"
        Width="340" Height="410"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,12,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="OK" Command="{Binding OkCommand}" Width="80" Padding="6,4" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" Click="OnCancelClick" Width="80" Padding="6,4" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="10">
            <StackPanel Spacing="4">
                <TextBlock Text="Client Name:" FontSize="12" />
                <!-- Editable combobox: suggestions from existing clients; new names typeable -->
                <AutoCompleteBox x:Name="ClientBox" Text="{Binding ClientName, Mode=OneWay}"
                                 ItemsSource="{Binding Clients}"
                                 MaxDropDownHeight="200" FontSize="12" TextChanged="OnClientBoxTextChanged" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Project Name:" FontSize="12" />
                <AutoCompleteBox x:Name="ProjectBox" Text="{Binding ProjectName, Mode=OneWay}"
                                 ItemsSource="{Binding Projects}"
                                 MaxDropDownHeight="200" FontSize="12" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Building Name:" FontSize="12" />
                <TextBox Text="{Binding BuildingName}" FontSize="12" />
            </StackPanel>
            <!-- Climate + Orientation: label-above rows like Building Name, so both
                 combos share the TextBoxes' left/right edges (explicit width: ComboBox
                 does not stretch) -->
            <StackPanel Spacing="4">
                <TextBlock Text="Climate Zone:" FontSize="12" />
                <ComboBox ItemsSource="{Binding ClimateZones}" SelectedItem="{Binding SelectedClimateZone}" Width="308" FontSize="12" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Orientation:" FontSize="12" />
                <ComboBox ItemsSource="{Binding Orientations}" SelectedItem="{Binding SelectedOrientation}" Width="308" FontSize="12" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
