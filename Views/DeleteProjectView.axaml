<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FenCalc2.ViewModels"
        x:Class="FenCalc2.Views.DeleteProjectView"
        x:DataType="vm:DeleteProjectViewModel"
        Title="Delete Project"
        Width="232" Height="270"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,12,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" IsVisible="{Binding !ConfirmMode}">
                <Button Content="Delete" Command="{Binding DeleteCommand}" Width="80" Padding="6,4" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" Click="OnCancelClick" Width="80" Padding="6,4" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" IsVisible="{Binding ConfirmMode}">
                <Button Content="Back" Command="{Binding BackCommand}" Width="80" Padding="6,4" />
                <Button Content="Yes, delete" Command="{Binding ConfirmDeleteCommand}" Classes="quiet"
                        Foreground="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                        Width="90" Padding="6,4" FontWeight="SemiBold" />
            </StackPanel>
        </StackPanel>

        <!-- Phase 1: pick the building -->
        <StackPanel Spacing="8" IsVisible="{Binding !ConfirmMode}">
            <StackPanel Spacing="4">
                <TextBlock Text="Client:" FontSize="12" />
                <ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}" Width="200" FontSize="12" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Project:" FontSize="12" />
                <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" Width="200" FontSize="12" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Building:" FontSize="12" />
                <ComboBox ItemsSource="{Binding Buildings}" SelectedItem="{Binding SelectedBuilding}" Width="200" FontSize="12" />
            </StackPanel>
        </StackPanel>

        <!-- Phase 2: confirm -->
        <StackPanel Spacing="8" IsVisible="{Binding ConfirmMode}">
            <TextBlock Text="{Binding ConfirmText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Left" />
            <TextBlock Text="All floors, windows and floor-plan images of this building will be permanently removed." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </DockPanel>
</Window>
