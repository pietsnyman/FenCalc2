<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Self-contained publishes: publish/win-x64 and publish/linux-x64 (see publish.ps1). -->
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Logo/icon artwork generated by tools/make_logo.py (python tools/make_logo.py). -->
    <ApplicationIcon>Assets\FenCalc2.ico</ApplicationIcon>
    <Product>FenCalc2</Product>
    <Authors>Piet Snyman</Authors>
    <Copyright>Copyright (c) 2026 Piet Snyman</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <!-- Curated catalogue seed (tools/export_seed.py) — see Data/CatalogueSeeder.cs. -->
    <EmbeddedResource Include="Data\seed\catalogue.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.8" />
    <!-- Legacy DB support: DataMigrator needs the Password= connection string, whose legacy
         CryptoAPI codec was removed from SQLite core in 3.32 and never existed in the NuGet
         netstandard builds (the "was not built with encryption" throw is compiled in). The
         only working binaries are the net46 codec-enabled ones used by the original FenCalc
         app (extracted from packages/System.Data.SQLite.Core.1.0.109.1, public domain).
         SQLite.Interop.dll must sit next to FenCalc2.exe; do not delete LegacySqlite/. -->
    <Reference Include="System.Data.SQLite">
      <HintPath>LegacySqlite\System.Data.SQLite.dll</HintPath>
    </Reference>
    <!-- Windows-only native codec for the legacy import (see DataMigrator). Not copied
         into linux-x64 publishes — nothing outside ImportOldDb ever loads it. -->
    <None Include="LegacySqlite\SQLite.Interop.dll" Link="SQLite.Interop.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))" />
  </ItemGroup>
</Project>
